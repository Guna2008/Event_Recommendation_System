generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// ==================================================
/// USER
/// ==================================================
model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  department         String?
  year               Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  preferredMode      String
  preferredEventType String[]
  skills             String[]
  interests          String[]

  interactions  Interaction[]
  searchHistory SearchHistory[]
  registrations Registration[]
  feedbacks     Feedback[]
}

/// ==================================================
/// EVENT
/// ==================================================
model Event {
  id                   Int       @id @default(autoincrement())
  title                String
  description          String?
  location             String?
  date                 DateTime?
  registrationUrl      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  cashPrize            Float?
  certificateAvailable Boolean   @default(false)
  contactEmail         String?
  contactNumber        String?
  domain               String?
  endTime              String?
  organizerDepartment  String?
  organizerName        String?
  posterUrl            String?
  registrationDeadline DateTime?
  registrationFee      Float?
  startTime            String?
  whatsappGroupLink    String?

  interactions  Interaction[]
  registrations Registration[]
  feedbacks     Feedback[]
}

/// ==================================================
/// INTERACTION
/// ==================================================
model Interaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  type      String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
}

/// ==================================================
/// SEARCH HISTORY
/// ==================================================
model SearchHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ==================================================
/// REGISTRATION
/// ==================================================
model Registration {
  id           Int       @id @default(autoincrement())
  userId       Int
  eventId      Int
  status       String    @default("REGISTERED")
  registeredAt DateTime  @default(now())
  attendedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  feedback Feedback?

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

/// ==================================================
/// FEEDBACK
/// ==================================================
model Feedback {
  id             Int    @id @default(autoincrement())
  registrationId Int    @unique
  userId         Int
  eventId        Int
  experience     String

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
}
